{
  "name": "@dafu/hermes",
  "version": "0.3.0",
  "description": "A background job framework for Deno with pluggable backends (Deno KV, BullMQ) and support for recurring jobs.",
  "license": "MIT",
  "exports": {
    ".": "./src/main.ts",
    "./backends/bullmq": "./src/lib/backends/bullmq.ts"
  },
  "publish": {
    "exclude": ["src/lib/tests/", "plans/", ".github/", ".claude/"]
  },
  "tasks": {
    "dev": "deno run --watch main.ts",
    "worker": "deno run --unstable-kv --unstable-cron example/worker.ts",
    "worker:redis": "deno run example/worker_redis.ts",
    "enqueue": "deno run --unstable-kv example/enqueue.ts",
    "enqueue:redis": "deno run example/enqueue_redis.ts",
    "test": "deno test -A --unstable-kv --unstable-cron",
    "test:integration": "deno test -A --unstable-kv --unstable-cron src/lib/tests/integration/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/main.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1",
    "@hermes": "./src/main.ts",
    "bullmq": "npm:bullmq@^5"
  }
}
